{
  "name": "leaflet-drift-marker",
  "version": "2.1.0",
  "private": false,
  "type": "module",
  "description": "Leaflet plugin for animated markers that move smoothly to a new position. Ideal for live GPS and vehicle tracking. TypeScript, with ESM, CommonJS and CDN builds.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.global.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugobarragon/leaflet-drift-marker.git"
  },
  "keywords": [
    "leaflet",
    "leaflet-plugin",
    "leaflet-marker",
    "marker",
    "animated-marker",
    "moving-marker",
    "sliding-marker",
    "marker-animation",
    "slideto",
    "animation",
    "map",
    "gps",
    "tracking",
    "real-time",
    "vehicle-tracking",
    "typescript"
  ],
  "author": "Hugo Barragon (http://github.com/hugobarragon)",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hugobarragon/leaflet-drift-marker/issues"
  },
  "homepage": "https://github.com/hugobarragon/leaflet-drift-marker#readme",
  "scripts": {
    "build": "tsup",
    "site": "npm run build && rm -rf .site && mkdir .site && cp demo/index.html .site/ && cp -r dist .site/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "leaflet": ">=1.2.0 <2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.23",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "leaflet": "^1.9.4",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
