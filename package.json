{
  "name": "leaflet-drift-marker",
  "version": "3.0.0-beta.0",
  "private": false,
  "type": "module",
  "description": "Leaflet 2 plugin for animated markers that move smoothly to a new position. Ideal for live GPS and vehicle tracking. TypeScript, ESM only.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./lib/index.js",
  "jsdelivr": "./lib/index.js",
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugobarragon/leaflet-drift-marker.git"
  },
  "keywords": [
    "leaflet",
    "leaflet-plugin",
    "leaflet-marker",
    "marker",
    "animated-marker",
    "moving-marker",
    "sliding-marker",
    "marker-animation",
    "slideto",
    "animation",
    "map",
    "gps",
    "tracking",
    "real-time",
    "vehicle-tracking",
    "typescript"
  ],
  "author": "Hugo Barragon (http://github.com/hugobarragon)",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hugobarragon/leaflet-drift-marker/issues"
  },
  "homepage": "https://github.com/hugobarragon/leaflet-drift-marker#readme",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "leaflet": "^2.0.0-beta.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "leaflet": "2.0.0-beta.5",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "publishConfig": {
    "tag": "next"
  }
}
